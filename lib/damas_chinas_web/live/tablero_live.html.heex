<Layouts.app flash={@flash}>
  <section
    id="tablero-session"
    phx-hook="JugadorSession"
    data-codigo={@codigo}
    class="fixed inset-0 grid place-items-center overflow-y-auto bg-[#0b0a24] p-4 font-nunito text-white"
  >
    <%!-- Fondo --%>
    <div class="pointer-events-none fixed inset-0 bg-[url('/images/fondo.webp')] bg-cover bg-center">
    </div>
    <div class="pointer-events-none fixed inset-0 bg-[#08061e]/45"></div>

    <div class={[
      vidrio(),
      "relative w-full max-w-4xl animate-emerger rounded-3xl p-6 sm:p-8"
    ]}>
      <%!-- Encabezado --%>
      <header class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-[0.65rem] font-extrabold tracking-[0.18em] text-white/55 uppercase">
            Sala {@codigo}
          </p>
          <h1 class="bg-linear-to-b from-white via-violet-100 via-40% to-purple-400 bg-clip-text font-display text-4xl font-extrabold text-transparent sm:text-5xl">
            Damas Chinas
          </h1>
        </div>
        <.boton_vidrio
          id="tablero-volver-lobby"
          disabled={is_nil(@jugador_id)}
          tamano={:chico}
          icono="hero-arrow-uturn-left"
          phx-click="volver_lobby"
        >
          Volver al lobby
        </.boton_vidrio>
      </header>

      <div class="mt-6 grid items-center gap-6 sm:grid-cols-[1fr_16rem]">
        <div class="min-w-0">
          <div
            id="tablero-estrella"
            role="group"
            aria-label="Tablero de damas chinas"
            class="tablero-estrella mx-auto w-full max-w-[32rem]"
          >
            <%= for fila <- @filas, {x, y} = posicion <- fila do %>
              <% ficha = @tablero[posicion] %>
              <% destino? = MapSet.member?(@destinos, posicion) %>
              <% propia? =
                ficha && @fase == :jugando && @jugador_id == ficha.id &&
                  match?(%{id: id} when id == ficha.id, @turno_jugador) %>
              <button
                id={"casilla-#{x}-#{y}"}
                type="button"
                phx-click="casilla"
                phx-value-x={x}
                phx-value-y={y}
                disabled={!(propia? || destino?)}
                aria-label={etiqueta_casilla(ficha, destino?, x, y)}
                aria-pressed={if(propia?, do: to_string(@seleccion == posicion))}
                class={[
                  "tablero-casilla",
                  ficha && "tablero-ficha",
                  Board.punta(posicion) && "tablero-punta",
                  @seleccion == posicion && "tablero-seleccion",
                  destino? && "tablero-destino"
                ]}
                style={estilo_casilla(posicion, ficha, Board.punta(posicion))}
              />
            <% end %>
          </div>
        </div>

        <%!-- Jugadores --%>
        <div>
          <p class={etiqueta()}>Jugadores</p>
          <ul id="tablero-jugadores" class="space-y-2">
            <li
              :for={jugador <- @jugadores}
              id={"tablero-jugador-#{jugador.id}"}
              class={[
                "flex items-center gap-3 rounded-xl border px-3 py-2.5",
                if(@fase == :jugando && @turno_jugador && @turno_jugador.id == jugador.id,
                  do: "border-limon-300/60 bg-limon-500/15",
                  else: "border-white/15 bg-[#060416]/45"
                )
              ]}
            >
              <span
                class={[
                  "size-5 shrink-0 rounded-full shadow-[inset_0_1px_2px_rgba(255,255,255,0.5)]",
                  "border border-white/25"
                ]}
                style={"background-color: #{Colores.hex(jugador.color)};"}
              >
              </span>
              <span class="flex-1 truncate font-bold">{jugador.nombre}</span>
              <span :if={jugador.id == @jugador_id} class="text-xs font-semibold text-white/55">
                (tú)
              </span>
            </li>
          </ul>
          <div
            id="tablero-estado"
            role="status"
            class="mt-4 text-sm leading-relaxed text-white/80"
          >
            <%= cond do %>
              <% @ganador -> %>
                <strong>{@ganador.nombre} ganó la partida.</strong>
              <% @fase == :finalizada -> %>
                La partida terminó porque quedó un solo jugador.
              <% @turno_jugador && @turno_jugador.id == @jugador_id -> %>
                <strong>Tu turno.</strong>
                {if(@seleccion,
                  do: "Elige una casilla resaltada.",
                  else: "Selecciona una de tus fichas."
                )}
              <% @turno_jugador -> %>
                Turno de <strong>{@turno_jugador.nombre}</strong>.
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
